<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Jekyller.App"
             xmlns:local="using:Jekyller"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#3D5AFE" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="#2A3142" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="Border.deploymentMonitor">
            <Setter Property="Background" Value="#1A2238" />
            <Setter Property="BorderBrush" Value="#3D5AFE" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.logBox">
            <Setter Property="Background" Value="#0D1218" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Application.Styles>
</Application>

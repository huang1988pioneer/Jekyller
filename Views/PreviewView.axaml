<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jekyller.ViewModels"
             x:Class="Jekyller.Views.PreviewView"
             x:DataType="vm:PreviewViewModel">
  <Grid RowDefinitions="Auto,*" Margin="8">
    <StackPanel Spacing="12">
      <TextBlock Text="本機預覽 (jekyll serve)" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="在本機啟動 Jekyll 開發伺服器。會帶入 _config.yml 的 baseurl，並包含草稿與未來日期文章。"
                 Opacity="0.75" TextWrapping="Wrap" />

      <Border Padding="14" CornerRadius="10"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding ProjectPathDisplay}" TextWrapping="Wrap" Opacity="0.9" />
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,8,8" />
            <NumericUpDown Grid.Column="1" Value="{Binding Port}" Minimum="1" Maximum="65535"
                           FormatString="0" Margin="0,0,8,8" Width="120" HorizontalAlignment="Left" />
            <CheckBox Grid.Column="2" Content="Live Reload" IsChecked="{Binding LiveReload}"
                      VerticalAlignment="Center" Margin="0,0,8,8" />
          </Grid>
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="停止" Command="{Binding StopCommand}"
                    IsEnabled="{Binding IsRunning}" HorizontalAlignment="Right" Margin="12,0,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
              <Button Content="啟動 jekyll serve" Command="{Binding StartCommand}" Classes="accent"
                      IsEnabled="{Binding CanStart}" />
              <Button Content="在瀏覽器開啟" Command="{Binding OpenBrowserCommand}" />
              <Button Content="清除日誌" Command="{Binding ClearLogCommand}" />
            </StackPanel>
          </DockPanel>
          <TextBox Text="{Binding SiteUrl}" IsReadOnly="True" PlaceholderText="Site URL" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,12,0,0" Padding="10" CornerRadius="10"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="伺服器輸出" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                 Classes="logBox"
                 TextWrapping="Wrap" FontFamily="Consolas,Courier New,monospace"
                 VerticalContentAlignment="Top" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>

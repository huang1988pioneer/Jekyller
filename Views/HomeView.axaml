<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jekyller.ViewModels"
             xmlns:models="using:Jekyller.Models"
             x:Class="Jekyller.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel Spacing="16" Margin="8">
      <TextBlock Text="Jekyller" FontSize="28" FontWeight="Bold" />
      <TextBlock Text="一鍵建立 Jekyll · Chirpy 表單設定 · Markdown 預覽 · jekyll serve · GitHub Pages"
                 Opacity="0.75" TextWrapping="Wrap" />

      <Border Classes="card" Padding="16" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="目前專案" FontWeight="SemiBold" FontSize="16" />
          <TextBlock Text="{Binding ProjectPath}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding StatusSummary}" Opacity="0.8" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="開啟專案資料夾" Command="{Binding OpenProjectCommand}" Classes="accent" />
            <Button Content="關閉專案" Command="{Binding CloseProjectCommand}" IsVisible="{Binding HasProject}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" Padding="16" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <StackPanel Spacing="10">
          <DockPanel>
            <CheckBox DockPanel.Dock="Right"
                      Content="啟動時自動開啟最近專案"
                      IsChecked="{Binding AutoOpenLastProject}"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0" />
            <TextBlock Text="最近專案" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="尚無最近專案。開啟或建立站台後，會出現在這裡。"
                     Opacity="0.7"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !HasRecentProjects}" />
          <ItemsControl ItemsSource="{Binding RecentProjects}" IsVisible="{Binding HasRecentProjects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:RecentProjectItem">
                <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="8" Background="#10161F">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="pill" Padding="8,2" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center">
                          <TextBlock Text="目前" FontSize="11" Foreground="#D0D7E5" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding FolderPath}" Opacity="0.7" FontSize="12"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="開啟"
                              Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenRecentCommand}"
                              CommandParameter="{Binding FolderPath}" />
                      <Button Content="移除"
                              Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).RemoveRecentCommand}"
                              CommandParameter="{Binding FolderPath}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Text="功能導覽" FontWeight="SemiBold" FontSize="16" Margin="0,8,0,0" />
      <UniformGrid Columns="2" Rows="4">
        <Border Margin="4" Padding="14" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="6">
            <TextBlock Text="⚙️ 環境建立" FontWeight="SemiBold" />
            <TextBlock Text="檢查 Ruby / Jekyll / Git，一鍵 gem install，jekyll new 建立站台，或從 GitHub Pages 複製" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Margin="4" Padding="14" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="6">
            <TextBlock Text="🎨 Chirpy 表單" FontWeight="SemiBold" />
            <TextBlock Text="完整表單設定 title / avatar / social / comments / PWA 等" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Margin="4" Padding="14" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="6">
            <TextBlock Text="📄 Markdown 預覽" FontWeight="SemiBold" />
            <TextBlock Text="編輯文章時即時預覽，略過 front matter；可開瀏覽器 HTML" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Margin="4" Padding="14" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="6">
            <TextBlock Text="👁 本機預覽" FontWeight="SemiBold" />
            <TextBlock Text="一鍵 jekyll serve + livereload，瀏覽器即時看整站" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Margin="4" Padding="14" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="6">
            <TextBlock Text="📝 站台設定" FontWeight="SemiBold" />
            <TextBlock Text="視覺化編輯 _config.yml 常用欄位，也可直接改 YAML" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Margin="4" Padding="14" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="6">
            <TextBlock Text="🚀 GitHub Pages" FontWeight="SemiBold" />
            <TextBlock Text="建立 repo、推送、啟用 Pages；本機沒有網站時，也可從 GitHub Pages 複製下來" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
          </StackPanel>
        </Border>
        <Border Margin="4" Padding="14" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <StackPanel Spacing="6">
            <TextBlock Text="✅ 建議流程" FontWeight="SemiBold" />
            <TextBlock Text="環境 → Chirpy → 寫文章 → serve 預覽 → 推 GitHub Pages；或從已上線的 Pages 複製到本機再編輯" TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
          </StackPanel>
        </Border>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

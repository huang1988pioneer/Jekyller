<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jekyller.ViewModels"
             xmlns:models="using:Jekyller.Models"
             x:Class="Jekyller.Views.GitHubView"
             x:DataType="vm:GitHubViewModel">
  <Grid RowDefinitions="*,Auto" Margin="8">
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" MaxWidth="980">
      <TextBlock Text="Git 儲存庫與 Pages" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="支援 GitHub、GitLab、Codeberg、Bitbucket 的 clone、連結、pull 與 push；GitHub 另支援 Actions Pages 自動部署與上線監控。"
                 Opacity="0.75" TextWrapping="Wrap" />

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="本機工具" Classes="sectionTitle" />
          <TextBlock Text="{Binding GitStatus}" />
          <TextBlock Text="{Binding GhStatus}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Content="重新整理狀態" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="GitHub 登入 (gh auth)" Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="只加入 workflow 檔" Command="{Binding AddWorkflowOnlyCommand}"
                    IsEnabled="{Binding HasLocalProject}" IsVisible="{Binding IsGitHubRemote}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" BorderBrush="#26A69A" BorderThickness="1">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="從 Git 平台複製到本機" Classes="sectionTitle" />
              <TextBlock Text="可貼 GitHub、GitLab、Codeberg、Bitbucket repository 網址；GitHub 也接受 Pages 網址並可列出帳號中的 Pages 網站。"
                         Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Classes="pill" Padding="10,4" VerticalAlignment="Top" Background="#1B3D38">
              <TextBlock Text="本機沒有網站時" Foreground="#B2DFDB" FontWeight="SemiBold" FontSize="12" />
            </Border>
          </Grid>

          <TextBox Text="{Binding RepositoryUrl}"
                   PlaceholderText="https://codeberg.org/owner/repository"
                   FontFamily="Consolas, Cascadia Mono, monospace" />

          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Text="父資料夾" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Column="1" Text="{Binding CloneParentDirectory}" Margin="0,0,8,8" />
            <Button Grid.Column="2" Content="瀏覽…" Command="{Binding BrowseCloneParentCommand}"
                    IsEnabled="{Binding !IsBusy}" Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Text="資料夾名稱" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CloneSiteName}" Margin="0,0,8,0"
                     PlaceholderText="預設為 repository 名稱" />
          </Grid>

          <Border Background="#101720" BorderBrush="#2A3648" BorderThickness="1"
                  CornerRadius="8" Padding="12">
            <TextBlock Text="{Binding CloneTargetSummary}" TextWrapping="Wrap"
                       Opacity="0.85" LineHeight="20" />
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="6" VerticalAlignment="Center">
              <Button Content="列出我的 GitHub Pages 網站" Command="{Binding ListPagesSitesCommand}"
                      IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding PagesSitesMessage}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="複製到本機並開啟"
                    Classes="accent" Command="{Binding CloneFromGitHubCommand}"
                    IsEnabled="{Binding CanCloneNow}" Margin="16,0,0,0"
                    VerticalAlignment="Center" />
          </Grid>

          <ItemsControl ItemsSource="{Binding PagesSites}" IsVisible="{Binding HasPagesSites}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:GitHubPagesSiteItem">
                <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="8" Background="#10161F">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                        <Border Classes="pill" Padding="8,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="#D0D7E5" />
                        </Border>
                        <Border Classes="pill" Padding="8,2" VerticalAlignment="Center"
                                IsVisible="{Binding IsPrivate}">
                          <TextBlock Text="{Binding VisibilityLabel}" FontSize="11" Foreground="#D0D7E5" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="12"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="複製這個"
                            VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:GitHubViewModel)DataContext).CloneListedSiteCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card" BorderBrush="#3D5AFE" BorderThickness="1"
              IsVisible="{Binding HasLocalProject}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="連結既有 Repository" Classes="sectionTitle" />
              <TextBlock Text="貼上四種支援平台的 repository 網址，安全合併遠端內容後推送；GitHub 會繼續設定 Actions Pages。"
                         Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Classes="pill" Padding="10,4" VerticalAlignment="Top">
              <TextBlock Text="推薦" Foreground="#C5D0FF" FontWeight="SemiBold" FontSize="12" />
            </Border>
          </Grid>

          <TextBox Text="{Binding RepositoryUrl}"
                   PlaceholderText="https://bitbucket.org/owner/repository"
                   FontFamily="Consolas, Cascadia Mono, monospace" />

          <Border Background="#101720" BorderBrush="#2A3648" BorderThickness="1"
                  CornerRadius="8" Padding="12">
            <TextBlock Text="{Binding RepositoryTargetSummary}" TextWrapping="Wrap"
                       Opacity="0.85" LineHeight="20" />
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <CheckBox Content="將 _config.yml 的 url / baseurl 同步為建議 Pages 網址"
                        IsChecked="{Binding SyncRecommendedSiteUrls}" />
              <TextBlock Text="若遠端已有 README，會先安全取得並保留；遇到衝突立即停止，不會 force push。"
                         Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="連結並推送"
                    Classes="accent" Command="{Binding ConnectExistingRepositoryCommand}"
                    IsEnabled="{Binding CanConnectNow}" Margin="16,0,0,0"
                    VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,*" IsVisible="{Binding HasLocalProject}">
        <Border Classes="card" Margin="0,0,6,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Repository 連線" Classes="sectionTitle" />
            <TextBlock Text="{Binding RemoteSummary}" Opacity="0.85" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="card" Grid.Column="1" Margin="6,0,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding HostingPlatformLabel, StringFormat='{}{0} Pages / 部署'}" Classes="sectionTitle" />
            <TextBlock Text="{Binding PagesSummary}" Opacity="0.85" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="查詢 Pages 狀態" Command="{Binding RefreshPagesStatusCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="開啟網站" Command="{Binding OpenPagesUrlCommand}"
                      IsEnabled="{Binding HasPagesUrl}" />
              <Button Content="啟用 Pages (Actions)" Command="{Binding EnablePagesCommand}"
                      IsEnabled="{Binding !IsBusy}" IsVisible="{Binding IsGitHubRemote}" />
            </StackPanel>
            <TextBlock Text="最近一次 Actions 部署" FontWeight="SemiBold" Margin="0,4,0,0"
                       IsVisible="{Binding IsGitHubRemote}" />
            <TextBlock Text="{Binding DeploymentStatus}" Opacity="0.85" TextWrapping="Wrap"
                       IsVisible="{Binding IsGitHubRemote}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card deploymentMonitor" IsVisible="{Binding HasLocalProject}">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <StackPanel Spacing="5" Margin="0,0,20,0">
            <TextBlock Text="線上版本監控" Classes="sectionTitle" />
            <TextBlock Text="{Binding DeploymentMonitorTitle}"
                       FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DeploymentMonitorSummary}"
                       Opacity="0.85" TextWrapping="Wrap" LineHeight="20" />
            <TextBlock Text="{Binding DeploymentMonitorSchedule}"
                       Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="立即檢查線上版本"
                  Command="{Binding CheckDeploymentNowCommand}"
                  IsEnabled="{Binding !IsCheckingDeployment}"
                  VerticalAlignment="Center" />
          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                       Margin="0,12,0,0" Height="3"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsCheckingDeployment}" />
        </Grid>
      </Border>

      <Border Classes="card" IsVisible="{Binding HasLocalProject}">
        <StackPanel Spacing="12">
          <TextBlock Text="建立新的 GitHub Repository（GitHub 專用）" Classes="sectionTitle" />
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Text="Repo 名稱" VerticalAlignment="Center" Margin="0,0,0,8" />
            <TextBox Grid.Column="1" Text="{Binding RepoName}"
                     PlaceholderText="my-jekyll-site（只填新 repository 名稱）" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Text="可見性" VerticalAlignment="Center" Margin="0,0,0,8" />
            <CheckBox Grid.Row="1" Grid.Column="1" Content="建立為 Private repository"
                      IsChecked="{Binding IsPrivate}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Text="Commit 訊息" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CommitMessage}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="建立新 Repo + 推送 + 啟用 Pages" Classes="accent"
                    Command="{Binding CreateAndDeployCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <Button Content="建置、提交並推送更新" Command="{Binding PushCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <Button Content="Pull" Command="{Binding PullCommand}"
                    IsEnabled="{Binding !IsBusy}" />
          </StackPanel>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="若 GitHub 上已有同名 repository，且是 Jekyll 網站（或空的／只有 README），會改走「連結既有」：保留遠端內容、衝突即停、不 force push。名稱被其他專案占用時會拒絕建立。" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="新 repository 流程：本機 Jekyll production build → 寫入 .github/workflows/jekyll.yml（若尚無 Pages workflow）→ git commit/push → GitHub Actions 以 Bundler 建置並部署。建置失敗時不會推送；請先 gh auth login。Chirpy starter 若已有 pages-deploy.yml 則不會重複建立。" />
        </StackPanel>
      </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="card" Margin="0,12,0,0">
      <Grid RowDefinitions="Auto,Auto,*" MaxWidth="980">
        <TextBlock Text="操作日誌" Classes="sectionTitle" />
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Opacity="0.75"
                   TextWrapping="Wrap" Margin="0,4,0,8" />
        <TextBox Grid.Row="2"
                 Text="{Binding Log}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 Classes="logBox"
                 Height="220"
                 TextWrapping="Wrap"
                 FontFamily="Consolas, Courier New, monospace"
                 VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      </Grid>
    </Border>
  </Grid>
</UserControl>

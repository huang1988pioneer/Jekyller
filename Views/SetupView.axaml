<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jekyller.ViewModels"
             x:Class="Jekyller.Views.SetupView"
             x:DataType="vm:SetupViewModel">
  <Grid RowDefinitions="*,Auto" Margin="8">
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" MaxWidth="980">
        <TextBlock Text="環境建立" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="檢查並安裝 Jekyll 所需工具，一鍵建立、開啟，或從 GitHub、GitLab、Codeberg、Bitbucket 複製專案。" Opacity="0.75" TextWrapping="Wrap" />

        <Border Classes="card">
          <StackPanel Spacing="8">
            <DockPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right">
                <Button Content="檢查環境" Command="{Binding CheckEnvironmentCommand}" Classes="accent"
                        IsEnabled="{Binding !IsBusy}" />
                <Button Content="安裝 Jekyll + Bundler" Command="{Binding InstallJekyllCommand}"
                        IsEnabled="{Binding !IsBusy}" />
              </StackPanel>
              <TextBlock Text="本機工具" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Tools}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" Margin="0,2" FontFamily="Consolas,Courier New,monospace" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="一鍵建立 Jekyll 站台" Classes="sectionTitle" />
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,4">
              <TextBlock Text="父資料夾" VerticalAlignment="Center" Margin="0,0,8,8" />
              <TextBox Grid.Column="1" Text="{Binding ParentDirectory}" Margin="0,0,8,8" />
              <Button Grid.Column="2" Content="瀏覽…" Command="{Binding BrowseParentCommand}" Margin="0,0,0,8" />

              <TextBlock Grid.Row="1" Text="網站名稱" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SiteName}" Margin="0,0,8,0" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="建立站台 (jekyll new)" Command="{Binding CreateSiteCommand}" Classes="accent"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="開啟既有專案" Command="{Binding OpenExistingCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="bundle install" Command="{Binding BundleInstallCommand}"
                      IsEnabled="{Binding !IsBusy}" />
              <Button Content="jekyll build" Command="{Binding BuildCommand}"
                      IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
            <TextBlock Text="{Binding ProjectPathDisplay}" Opacity="0.8" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card" BorderBrush="#26A69A" BorderThickness="1">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="從 Git 平台複製到本機" Classes="sectionTitle" />
                <TextBlock Text="貼上 GitHub、GitLab、Codeberg 或 Bitbucket repository 網址，即可 clone 到上方父資料夾並開啟。"
                           Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Classes="pill" Padding="10,4" VerticalAlignment="Top" Background="#1B3D38">
                <TextBlock Text="線上已有網站" Foreground="#B2DFDB" FontWeight="SemiBold" FontSize="12" />
              </Border>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="Repository / Pages" VerticalAlignment="Center" Margin="0,0,8,8" />
              <TextBox Grid.Column="1" Text="{Binding CloneRepositoryUrl}" Margin="0,0,0,8"
                       PlaceholderText="https://gitlab.com/owner/repository"
                       FontFamily="Consolas, Cascadia Mono, monospace" />

              <TextBlock Grid.Row="1" Text="資料夾名稱" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CloneSiteName}"
                       PlaceholderText="預設為 repository 名稱" />
            </Grid>

            <TextBlock Text="{Binding CloneTargetSummary}" Opacity="0.85" TextWrapping="Wrap" />
            <Button Content="複製到本機並開啟" Classes="accent"
                    Command="{Binding CloneFromGitHubCommand}"
                    IsEnabled="{Binding CanCloneNow}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="card" Margin="0,12,0,0">
      <DockPanel MaxWidth="980">
        <TextBlock DockPanel.Dock="Top" Text="輸出日誌" Classes="sectionTitle" Margin="0,0,0,6" />
        <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                 Classes="logBox"
                 Height="180"
                 TextWrapping="Wrap" FontFamily="Consolas,Courier New,monospace"
                 VerticalContentAlignment="Top" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
